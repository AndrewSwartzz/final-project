[node name="Npc6" parent="." unique_id=2073034404 instance=ExtResource("8_ccty1")]
position = Vector2(472, 45)
scale = Vector2(2, 2)
dialogue_text = "Before you could even remember feeling tranquility, I was already there, quietly feeding at the back of your mind."
npc_texture = ExtResource("16_5lxt1")

[node name="Npc7" parent="." unique_id=1576014559 instance=ExtResource("17_5lxt1")]
position = Vector2(-188, 283)
scale = Vector2(0.5, 0.5)
dialogue_text = "You should fear what comes next. The future shifts when you look at it… and every version ends with you begging for the past. Uncertainty is just despair that hasn’t introduced itself yet."

[node name="Npc8" parent="." unique_id=116118846 instance=ExtResource("8_ccty1")]
position = Vector2(3, 746)
scale = Vector2(1.6, 1.6)
dialogue_text = "The unknown will always hunger for us.It feeds on isolation.On silence.On the belief that you are facing it alone.Do not give it that satisfaction."
npc_texture = ExtResource("18_o32hu")

[node name="Npc9" parent="." unique_id=888222975 instance=ExtResource("8_ccty1")]
position = Vector2(-51, 616)
dialogue_text = "The horrors ahead are endless.They will change shape.They will whisper new fears.But as long as we have one another…they will never have all of us."
npc_texture = ExtResource("19_iop0d")

