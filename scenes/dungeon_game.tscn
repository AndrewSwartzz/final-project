texture = ExtResource("12_rc3rg")

[node name="Npc4" parent="." unique_id=1515419993 instance=ExtResource("8_ccty1")]
position = Vector2(252.00002, -305)
scale = Vector2(1.2, 1.2)
dialogue_text = "I have spent so long trying to repair myself.Yet each fix reveals another fracture underneath.Another thing rotting.Another thing growing.Perhaps this is all I am now."
npc_texture = ExtResource("13_buyf4")

[node name="Npc5" parent="." unique_id=560871398 instance=ExtResource("8_ccty1")]
position = Vector2(-57, -174)
dialogue_text = "Change your name.Change your face.Change the way you speak.They will still know it’s you.And you will still be nothing."
npc_texture = ExtResource("14_m8suj")

