[node name="Npc" parent="." unique_id=978063677 instance=ExtResource("8_ccty1")]
position = Vector2(214, -91)
dialogue_text = "They hide in the walls. In the dirt. Under your skin. When they’re all gone, maybe we can finally sleep. Do you feel them moving too? No? Then they must be hiding from you. All 4 of them."
npc_texture = ExtResource("9_psd7s")

[node name="Npc2" parent="." unique_id=1787124150 instance=ExtResource("8_ccty1")]
position = Vector2(38, 161)
dialogue_text = "The one clutching the egg cannot be trusted. Something inside it scratches when he thinks no one is listening. That egg is wrong. I can smell panic leaking from its shell."
npc_texture = ExtResource("10_b1nt2")

[node name="Npc3" parent="." unique_id=1232968488 instance=ExtResource("8_ccty1")]
position = Vector2(-194, -65)
dialogue_text = "Do not come closer. Sudden movements upset it. Loud noises upset it. Being alone upsets it. Everything upsets it. That thing with the nose fills your head with lies. This egg is safe with me. It must stay with me."
npc_texture = ExtResource("11_spf7w")

[node name="ChatGptImageMay12,2026,013602Am" type="Sprite2D" parent="." unique_id=780026803]
z_index = 1
position = Vector2(78.6875, -438.25)
